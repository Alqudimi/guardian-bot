# ─────────────────────────────────────────────────────────────────────────────
# Telegram Group Protection Bot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ── Infrastructure ────────────────────────────────────────────────────────────
POSTGRES_DB=tgbot
POSTGRES_USER=tgbot
POSTGRES_PASSWORD=replace_with_a_long_random_password
REDIS_PASSWORD=replace_with_another_long_random_password
DATABASE_URL=postgresql+asyncpg://tgbot:replace_with_a_long_random_password@localhost:5432/tgbot
REDIS_URL=redis://:replace_with_another_long_random_password@localhost:6379/0
# Development convenience only; set false in staging/production and run Alembic first.
AUTO_CREATE_TABLES=true

# ── Admins (comma-separated Telegram user IDs) ────────────────────────────────
TELEGRAM_ADMIN_IDS=123456789,987654321

# ── Webhook (leave empty to use long polling in development) ──────────────────
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PORT=8443
TELEGRAM_WEBHOOK_SECRET=

# ── Private Admin Gateway (disabled by default; never expose its token) ───────
ADMIN_GATEWAY_ENABLED=false
ADMIN_GATEWAY_HOST=127.0.0.1
ADMIN_GATEWAY_PORT=8765
ADMIN_GATEWAY_TOKEN=

# ── Telegram Payments ──────────────────────────────────────────────────────────
# Provider token from BotFather > Bot Settings > Payments. Empty disables deposits.
PAYMENT_PROVIDER_TOKEN=
PAYMENT_CURRENCY=USD

# ── AI Models ─────────────────────────────────────────────────────────────────
ARABIC_TOXICITY_MODEL=hossam87/bert-base-arabic-hate-speech
NSFW_MODEL=Marqo/nsfw-image-detection-384
MODEL_CACHE_DIR=./model_cache
MODEL_DEVICE=cpu

# ── Thresholds (0.0 – 1.0) ───────────────────────────────────────────────────
TOXICITY_THRESHOLD=0.65
NSFW_THRESHOLD=0.75
SPAM_SCORE_THRESHOLD=60.0
PHISHING_THRESHOLD=0.70

# ── Flood / Rate Limits ───────────────────────────────────────────────────────
FLOOD_WINDOW_SECONDS=10
FLOOD_MAX_MESSAGES=8
BURST_WINDOW_SECONDS=3
BURST_MAX_MESSAGES=4
DUPLICATE_WINDOW_SECONDS=30

# ── Anti-Ban Safety ───────────────────────────────────────────────────────────
ACTION_RATE_LIMIT_PER_MINUTE=20
ACTION_COOLDOWN_PER_USER_SECONDS=5
BAN_HOURLY_LIMIT=10
DELETE_RATE_PER_MINUTE=30
ACTION_JITTER_MIN=0.3
ACTION_JITTER_MAX=1.2

# ── Raid Detection ────────────────────────────────────────────────────────────
RAID_JOIN_WINDOW_SECONDS=30
RAID_JOIN_THRESHOLD=10

# ── Celery (background tasks) ─────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:replace_with_another_long_random_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:replace_with_another_long_random_password@localhost:6379/2

# ── Operation ─────────────────────────────────────────────────────────────────
# Use development for local polling; production requires a valid token and live services.
ENVIRONMENT=development
DRY_RUN=true
LOG_LEVEL=INFO
LOG_JSON=true
